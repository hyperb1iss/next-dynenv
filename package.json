{
    "name": "next-dynenv",
    "version": "4.1.0",
    "description": "Dynamic runtime environment variables for Next.js - populate your environment at runtime, not build time.",
    "type": "module",
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/index.js",
            "default": "./build/index.js"
        }
    },
    "files": [
        "build"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20.9.0"
    },
    "scripts": {
        "lint": "biome check . && prettier --check \"**/*.{md,mdx,yml,yaml}\"",
        "lint:fix": "biome check --write . && prettier --write \"**/*.{md,mdx,yml,yaml}\"",
        "lint:all": "biome check --write --unsafe . && prettier --write \"**/*.{md,mdx,yml,yaml}\"",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "test:integration": "node test-app/integration-test.mjs",
        "build": "tsc -p tsconfig.build.json",
        "build:watch": "pnpm build --watch"
    },
    "keywords": [
        "nextjs",
        "next.js",
        "runtime",
        "environment",
        "env",
        "dynamic",
        "runtime-env",
        "next-dynenv",
        "docker",
        "kubernetes",
        "twelve-factor"
    ],
    "author": "Stefanie Jane <info@hyperbliss.tech> (Forked from Expatfile.tax LLC)",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/hyperb1iss/next-dynenv.git"
    },
    "bugs": {
        "url": "https://github.com/hyperb1iss/next-dynenv/issues"
    },
    "homepage": "https://github.com/hyperb1iss/next-dynenv#readme",
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@testing-library/jest-dom": "catalog:",
        "@testing-library/react": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "jsdom": "catalog:",
        "next": "catalog:",
        "prettier": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "next": "^15 || ^16",
        "react": "^19"
    },
    "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
